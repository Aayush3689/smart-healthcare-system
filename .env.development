NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,*

# The database port is 5434 on the development Docker Compose host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_healthcare
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/smart_healthcare?schema=public"

JWT_SECRET=replace-with-a-long-random-development-secret

# Configure a real SMTP account to receive login OTPs during local development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=replace-with-16-character-google-app-password
SMTP_FROM="Smart Healthcare Development <your-gmail-address@gmail.com>"

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000

SEED_PHC_NAME="Development Primary Health Centre"
SEED_PHC_CODE=DEV-PHC-001
SEED_PHC_ADDRESS="Development PHC address"
SEED_PHC_DISTRICT="Development district"
SEED_PHC_STATE="Development state"
SEED_ADMIN_EMAIL=mdzeeshank578@gmail.com
SEED_ADMIN_NAME="PHC Admin"
