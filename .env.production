NODE_ENV=production
PORT=4000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-production-password
POSTGRES_DB=smart_healthcare
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/smart_healthcare?schema=public"
JWT_SECRET="replace-with-a-long-random-production-secret"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Use a Google App Password, not your normal Gmail password.
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=replace-with-16-character-google-app-password
SMTP_FROM="Smart Healthcare <your-gmail-address@gmail.com>"
SEED_PHC_NAME="Production PHC"
SEED_PHC_CODE=PROD-PHC-001
SEED_PHC_ADDRESS="Replace with PHC address"
SEED_PHC_DISTRICT="Replace with district"
SEED_PHC_STATE="Replace with state"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME="PHC Admin"
